# Python cache
__pycache__/
*.py[cod]
*.pyo
*.bak

# Virtual environment
.venv/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VS Code settings (optional)
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Logs / junk
*.log
*.tmp

# Raw env-check console dump (curated summary lives in ENV_SNAPSHOT.md)
env_check_results.txt

# Model files (optional, if you want to use Git LFS or HF Hub)
*weekend*.pt
*.ckpt
*.npz
*.pt

# Ignore all TensorBoard event files
**/runs/
*.tfevents.*
**/metrics_log.jsonl

# Arena runtime state (per-machine; regenerated by training, carries local agent names)
models/arena/

# home_batch.py outputs -- generated at home; report carries the local repo path,
# scratch dir holds throwaway smoke/sweep/seed checkpoints. Paste-back only, never commit.
home_batch_report.md
loss_logs/home_batch/

# Claude lol
.claudeignore
CLAUDE.md

# C++ build artifacts
engine/cpp/build/
engine/cpp/__pycache__/

# Compiled extension
engine/cpp/*.pyd
engine/cpp/*.so
engine/cpp/*.dll

# Profiling
*.prof

# Generated benchmark runs (curated milestone reports live at repo root)
results/

# ONNX export intermediates -- fp32 is reproducible from checkpoint; only int8 ships
docs/models/model.onnx
