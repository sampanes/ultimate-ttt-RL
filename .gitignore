# Python cache
__pycache__/
*.py[cod]
*.pyo
*.bak

# Virtual environment
.venv/

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# VS Code settings (optional)
.vscode/

# OS cruft
.DS_Store
Thumbs.db

# Logs / junk
*.log
*.tmp

# Raw env-check console dump (curated summary lives in ENV_SNAPSHOT.md)
env_check_results.txt

# Model files (optional, if you want to use Git LFS or HF Hub)
*weekend*.pt
*.ckpt
*.npz
*.pt

# Ignore all TensorBoard event files
**/runs/
*.tfevents.*
**/metrics_log.jsonl

# Arena runtime state (per-machine; regenerated by training, carries local agent names)
models/arena/

# AlphaZero runtime state + archived local runs (checkpoints already hit *.pt;
# this also covers run_state.json and other per-machine metadata)
models/alphazero*/

# Expert-iteration runtime state (shards, state.json; checkpoints hit *.pt)
models/expert_iter*/

# Frozen distillation corpora (expert_iter --generate_only). Regenerable, and
# large: the gen-22 corpus is 1.6 GB of shards. Never commit.
models/corpus_*/

# Offline architecture-A/B students + their panel json (RESULT_ARCH_AB.md)
models/ab_arch/

# home_batch.py outputs -- generated at home; report carries the local repo path,
# scratch dir holds throwaway smoke/sweep/seed checkpoints. Paste-back only, never commit.
home_batch_report.md
loss_logs/home_batch/

# bench_throughput.py outputs -- same paste-back-only convention, see BENCH_THROUGHPUT_PLAN.md
bench_throughput_report.md
loss_logs/bench_throughput/

# Claude lol
.claudeignore
CLAUDE.md

# C++ build artifacts
engine/cpp/build/
engine/cpp/__pycache__/

# Compiled extension
engine/cpp/*.pyd
engine/cpp/*.so
engine/cpp/*.dll

# Profiling
*.prof

# Generated benchmark runs (curated milestone reports live at repo root)
results/

# int8 ONNX intermediate -- ConvInteger op not supported by onnxruntime-web WASM;
# serving fp32 (model.onnx) instead. Kept locally for re-quantization experiments.
docs/models/model_int8.onnx
